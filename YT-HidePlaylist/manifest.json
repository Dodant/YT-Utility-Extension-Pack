{
  "manifest_version": 3,
  "name": "YT Hide Playlist",
  "description": "Hide playlist and mix cards from YouTube recommendations with one checkbox.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "YT Hide Playlist",
    "default_popup": "src/popup.html"
  }
}
