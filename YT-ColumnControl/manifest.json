{
  "manifest_version": 3,
  "name": "YT Column Control",
  "description": "Choose how many videos fit in each row of the YouTube home feed.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "YT Column Control",
    "default_popup": "src/popup.html"
  }
}
