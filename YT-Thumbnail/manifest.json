{
  "manifest_version": 3,
  "name": "YouTube Thumbnail Peek",
  "short_name": "Thumbnail Peek",
  "version": "0.1.0",
  "description": "Hover near the right edge of a YouTube video title to preview the video's thumbnail.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
